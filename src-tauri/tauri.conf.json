{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cleaner Max",
  "version": "0.2.0",
  "identifier": "com.letrucdev.cleanermax",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cleaner Max",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "letrucdev",
    "copyright": "Copyright © 2026 letrucdev",
    "shortDescription": "Dọn dung lượng ổ C: cho Windows, WSL và Docker",
    "longDescription": "Cleaner Max tìm và dọn cache của công cụ lập trình, build artifact của dự án cũ, rác Windows và các ổ ảo WSL/Docker phình to, luôn cho xem trước trước khi xóa.",
    "category": "Utility"
  },
  "mainBinaryName": "cleaner-max"
}
